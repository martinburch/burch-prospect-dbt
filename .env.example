# Copy to .env and adjust as needed: cp .env.example .env

# Custom Airflow image (built from Dockerfile)
AIRFLOW_IMAGE_NAME=prospect-airflow:3.2.1

# User ID for Airflow containers (Linux: set to `id -u`; macOS often uses 50000)
AIRFLOW_UID=50000

# Base directory for volume mounts
AIRFLOW_PROJ_DIR=.

# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT secret for Airflow API (change in production)
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret

# dbt + DuckDB paths inside containers
DUCKDB_PATH=/opt/airflow/database/transfermarkt-datasets.duckdb
DBT_PROJECT_PATH=/opt/airflow/dbt

# Cosmos DuckDB connection (host maps to dbt profile path)
AIRFLOW_CONN_DUCKDB_DEFAULT=duckdb://%2Fopt%2Fairflow%2Fdatabase%2Ftransfermarkt-datasets.duckdb

# Airflow UI credentials (created on first init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
